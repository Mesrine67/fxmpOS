{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "fxmp-os",
  "productName": "FXMP OS",
  "version": "0.0.8",
  "identifier": "org.computer.os",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out",
    "removeUnusedCommands": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FXMP",
    "category": "Utility",
    "shortDescription": "PC monitoring and desktop overlay",
    "longDescription": "FXMP OS is a desktop PC monitoring app with a configurable system overlay.",
    "copyright": "Copyright © 2026 FXMP. All rights reserved.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "FXMP OS",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NkM2NjkzNUIwMDExMDgKUldRSUVRQmJrMlpzK1A4TnlDUnNGNWd0bjhkVk96bHZkWjFROHpFVzA0VlpnWVlkY0FPMk1Mc2kK",
      "endpoints": [
        "https://github.com/Mesrine67/fxmpOS/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FXMP OS",
        "width": 1400,
        "height": 918,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "userAgent": "FXMP.OS/0.0.8-dev"
      },
      {
        "label": "overlay",
        "create": false,
        "title": "FXMP OS Overlay",
        "url": "overlay/",
        "width": 380,
        "height": 104,
        "minWidth": 380,
        "minHeight": 104,
        "maxWidth": 380,
        "maxHeight": 104,
        "decorations": false,
        "closable": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "userAgent": "fxmp-os-overlay"
      }
    ],
    "security": {
      "capabilities": ["default", "overlay"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  }
}
