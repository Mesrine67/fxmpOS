{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-menu",
  "description": "Accès aux préférences de thème et navigation depuis le panneau tray FXMP OS",
  "local": true,
  "windows": ["tray-menu"],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:window:allow-hide",
    "core:window:allow-set-effects",
    "store:allow-load",
    "store:allow-get"
  ]
}
