{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the local FXMP OS main window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-default-urls",
    "log:allow-log",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "autostart:default",
    "allow-greet",
    "allow-get-system-snapshot",
    "allow-get-resource-sample",
    "allow-get-network-endpoints",
    "allow-get-installed-apps",
    "allow-get-display-monitors",
    "allow-measure-network-latency",
    "allow-set-overlay-state",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-activate-main-window",
    "allow-toggle-dock",
    "allow-open-dock-settings",
    "allow-set-dock-shortcut",
    "allow-get-input-viewer-state",
    "allow-set-input-viewer-state"
  ]
}
