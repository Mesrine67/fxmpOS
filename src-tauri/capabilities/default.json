{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the local FXMP OS main window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-default-urls",
    "log:allow-log",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "autostart:default",
    "allow-greet",
    "allow-get-system-snapshot",
    "allow-get-installed-apps",
    "allow-get-display-monitors",
    "allow-measure-network-latency",
    "allow-set-overlay-state",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
